@model IEnumerable<Backend_ASP.NET.Models.StatsModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="wrapper">
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h1 class="card-title">THỐNG KÊ THÔNG TIN DƯ NỢ CỦA QUÁN</h1>
                                </div>
                               
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <table id="example1" class="table table-bordered table-striped">
                                    <thead>
                                            @foreach (var item in Model)
                                            {
                                            <tr><th><strong>@item.Month</strong></th><th>Tiền nợ: @item.Debt.ToString("N0") đồng</th> </tr>
                                            }
                                    </thead>
                                    </table>
                                
                                <div style="width: 50%">
                                    <canvas id="myChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let labels = [];
    let data = [];
    @foreach (var item in Model)
    {
        @:labels.push('@item.Month');
        @:data.push(@item.Debt);
    }

        window.onload = function() {
            const ctx = document.getElementById('myChart');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tiền nợ',
                        data: data,
                        borderWidth: 1,
                        backgroundColor: ['red', 'green', 'blue', 'yellow', 'purple', 'orange']
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Tiền nợ (đồng)'
                            }
                        }
                    }
                }
            });
        }
</script>